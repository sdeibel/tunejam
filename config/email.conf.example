# SMTP configuration for magic-link login emails
#
# Copy this file to email.conf and fill in the values below.
# email.conf is gitignored and will not be committed.
#
# The server uses SMTP with STARTTLS on the configured port.
#
# host=smtp.zoho.com
# port=587
# username=user@example.com
# password=PASSWORD_HERE
# from_address=user@example.com
#
# Comma-separated list of email addresses with admin access.
# Admin users can edit tunes and manage the cache.
# Regular users can create and manage events.
#
# admin_emails=admin@example.com,other@example.com
